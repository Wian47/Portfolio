{
  // The Worker runs on workerd, not in a browser. Its globals (Response, fetch,
  // crypto) are Cloudflare's rather than the DOM's, so pulling both sets of
  // types into one program would make every `Response` ambiguous. The site's
  // tsconfig excludes this directory for the same reason.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../trip/**/*.ts"],
  // `trip/api.ts` is the browser's side of the same contract and speaks DOM
  // fetch, which workerd's RequestInit does not have. The Worker never imports it.
  "exclude": ["../trip/**/*.test.ts", "../trip/api.ts"]
}
